{
  "name": "hbtc-scouter",
  "version": "1.0.0",
  "description": "HBTC Community Scouter - XP Tracking & Battle System",
  "main": "scouter-server-complete.js",
  "type": "module",
  "scripts": {
    "start": "node scouter-server-complete.js",
    "bot": "node discord-bot.js",
    "dev": "node --watch scouter-server-complete.js",
    "deploy": "pm2 start scouter-server-complete.js --name 'hbtc-scouter' && pm2 start discord-bot.js --name 'hbtc-bot'",
    "stop": "pm2 stop hbtc-scouter hbtc-bot",
    "restart": "pm2 restart hbtc-scouter hbtc-bot",
    "logs": "pm2 logs"
  },
  "dependencies": {
    "express": "^4.18.2",
    "ws": "^8.14.2",
    "discord.js": "^14.13.0",
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "@tiktool/live": "^1.0.0"
  },
  "devDependencies": {
    "pm2": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "HBTC",
  "license": "MIT"
}
